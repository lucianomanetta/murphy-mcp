{
  "name": "murphy-mcp",
  "version": "0.1.0",
  "description": "An MCP server that gives a coding agent a record it did not write: what actually changed on disk and in git, held against what the agent said it did.",
  "license": "MIT",
  "author": "Luciano Manetta",
  "type": "module",
  "bin": {
    "murphy-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "coding-agents",
    "observability",
    "verification",
    "audit",
    "evidence"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucianomanetta/murphy-mcp.git"
  },
  "homepage": "https://github.com/lucianomanetta/murphy-mcp#readme",
  "bugs": {
    "url": "https://github.com/lucianomanetta/murphy-mcp/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node test/smoke.mjs",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
